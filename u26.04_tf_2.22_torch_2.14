ARG BASE=ubuntu:26.04
FROM ${BASE} AS working
LABEL maintainer="Andrew W. Steiner <awsteiner0@protonmail.com>"

ENV DEBIAN_FRONTEND=noninteractive
 
# ───────────────────────────────────────────────────────────────────
# Install Python, pip, and curl

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 curl ca-certificates pkg-config gcc \
        libhdf5-dev && apt-get clean

# Install an up-to-date pip (instead of Debian's python3-pip)
RUN curl -sSL https://bootstrap.pypa.io/get-pip.py | python3 - --break-system-packages
 
# ───────────────────────────────────────────────────────────────────
# Install HDF5

#WORKDIR /opt
#RUN curl -L "https://github.com/HDFGroup/hdf5/releases/download/hdf5_1.14.6/hdf5-1.14.6-ubuntu-2404_gcc.deb" -o hdf5-1.14.6-ubuntu-2404_gcc.deb
#RUN dpkg -i hdf5-1.14.6-ubuntu-2404_gcc.deb
#RUN rm -f hdf5-1.14.6-ubuntu-2404_gcc.deb

# ───────────────────────────────────────────────────────────────────
# Ensure h5py uses the installed version of HDF5

#RUN HDF5_DIR=/HDF_Group/HDF5/1.14.6

RUN pip3 install --break-system-packages h5py
#  --no-binary=h5py 

# ───────────────────────────────────────────────────────────────────
# Install TensorFlow and Torch

# Note that Tensorflow and Torch both include their own cuda libraries
# which are separate from the base image.

RUN pip3 install --break-system-packages \
absl-py==2.3.1 \
astunparse==1.6.3 \
certifi==2025.10.5 \
charset-normalizer==3.4.4 \
filelock==3.20.3 \
flatbuffers==25.9.23 \
fsspec==2025.10.0 \
gast==0.6.0 \
google-pasta==0.2.0 \
grpcio==1.76.0 \
h5py==3.15.1 \
idna==3.15 \
joblib==1.5.2 \
Jinja2==3.1.6 \
keras==3.15.0 \
libclang==18.1.1 \
Markdown==3.9 \
markdown-it-py==4.0.0 \
MarkupSafe==3.0.3 \
mdurl==0.1.2 \
ml-dtypes==0.5.3 \
mpmath==1.3.0 \
msgpack==1.2.1 \
namex==0.1.0 \
networkx==3.5 \
numpy==2.3.4 \
opt_einsum==3.4.0 \
optree==0.17.0 \
packaging==26.0 \
pillow==12.3.0 \
pip_audit==2.10.0 \
protobuf==6.33.5 \
Pygments==2.20.0 \
requests==2.33.0 \
rich==14.2.0 \
scikit-learn==1.7.2 \
scipy==1.16.3 \
setuptools==83.0.0 \
six==1.17.0 \
sympy==1.14.0 \
termcolor==3.2.0 \
threadpoolctl==3.6.0 \
typing_extensions==4.15.0 \
urllib3==2.8.0 \
Werkzeug==3.1.8 \
wrapt==2.0.0

ARG TF_VERSION=tensorflow_cpu==2.22.0rc0
RUN pip3 install --break-system-packages ${TF_VERSION}

ARG TORCH_VERSION="torch==2.14.1"
ARG TORCH_URL="https://download.pytorch.org/whl/cpu"
RUN pip3 install --break-system-packages ${TORCH_VERSION} \
  --index-url ${TORCH_URL}

#RUN pip3 install --break-system-packages setuptools==83.0.0

# If desired, output pip requirements file here
#FROM working

# ───────────────────────────────────────────────────────────────────
# Copy scripts (even though we don't have cuda these are useful for
# reporting version information)

WORKDIR /opt
COPY nocuda_check.sh ./
RUN chmod 777 nocuda_check.sh

# ───────────────────────────────────────────────────────────────────
# Set environment variables

#ENV LD_LIBRARY_PATH=/HDF_Group/HDF5/1.14.6/lib
WORKDIR /root
