ARG BASE=nvidia/cuda:13.4.3-cudnn-devel-ubuntu26.04
FROM ${BASE} AS working
LABEL maintainer="Andrew W. Steiner <awsteiner0@protonmail.com>"

# ───────────────────────────────────────────────────────────────────
# 11/20/26: Through CUDA minor version compatibility, this image runs
# on R580 drivers (CUDA 13.0) as well as newer ones. However,
# nvidia/cuda images declare "cuda>=13.4", and the container toolkit
# refuses to start them on an older driver. We disable that check
# here. With an R580 driver, features introduced after CUDA 13.0 may
# fail with cudaErrorCallRequiresNewerDriver. You may remove this line
# if your driver is R615 or newer.

ENV NVIDIA_DISABLE_REQUIRE=1

# ───────────────────────────────────────────────────────────────────
# Prevent tzdata (and other packages) from prompting during apt-get
# install. The timezone defaults to UTC. To use a different one, run
# the container with e.g. "-e TZ=America/Los_Angeles", or run
# "dpkg-reconfigure tzdata" inside a container.

ARG DEBIAN_FRONTEND=noninteractive

# ───────────────────────────────────────────────────────────────────
# Install Python, pip, curl, and HDF5

RUN apt-get -y update && apt-get -y install \
  python3 python3-dev curl build-essential pkg-config \
  libhdf5-dev && apt-get clean

# Install an up-to-date pip (instead of Debian's python3-pip)
RUN curl -sSL https://bootstrap.pypa.io/get-pip.py | \
  python3 - --break-system-packages pip==26.3

# ───────────────────────────────────────────────────────────────────
# Ensure h5py uses the Ubuntu version of HDF5
#
# Ubuntu does not install HDF5 under a single prefix, so we give h5py
# the header and library directories of the serial build instead of
# HDF5_DIR.
#
# On Python 3.14, TF 2.22 requires h5py~=3.15.1 (on Python 3.13 and
# earlier it requires h5py<3.15).

RUN HDF5_INCLUDEDIR=/usr/include/hdf5/serial \
  HDF5_LIBDIR=/usr/lib/x86_64-linux-gnu/hdf5/serial \
  pip3 install --break-system-packages --no-binary=h5py h5py==3.15.1

# ───────────────────────────────────────────────────────────────────
# Install TensorFlow
#
# TF 2.22 adds CUDA 13 support as the separate tensorflow-cuda13
# package. It is built against CUDA 13.0 and uses the CUDA libraries
# in the base image (13.4, compatible within the 13.x series), so we
# do not install the [and-cuda] extra.
#
# The 2.22 release candidates depend on keras-nightly rather than
# keras. Both install into the same "keras" module, so we remove
# keras-nightly and then install a pinned keras release.

ARG TF_VERSION=tensorflow-cuda13==2.22.0rc1
RUN pip3 install --break-system-packages ${TF_VERSION}
RUN pip3 uninstall -y --break-system-packages keras-nightly && \
  pip3 install --break-system-packages keras==3.15.1

# ───────────────────────────────────────────────────────────────────
# Install Torch

# 2/24/26: We install torch without dependencies, since most of them
# (cuDNN, cuBLAS, cuFFT, cuSOLVER, cuSPARSE, NVRTC, and the CUDA
# runtime) are already in the CUDA image. This keeps most of the
# functionality but saves about 2 GB in image size. However, this
# also requires we manually install the dependencies the image lacks.

# Of the packages below, filelock, typing-extensions, setuptools,
# sympy, networkx, jinja2, fsspec, cuda-bindings, triton,
# nvidia-cusparselt-cu13, and nvidia-nvshmem-cu13 are torch
# dependencies, with versions following the torch 2.15.0 requirements
# on PyPI. NCCL is installed from apt below. The remaining packages
# are pinned to versions without known vulnerabilities.

RUN pip3 install --break-system-packages \
  certifi==2026.10.23 \
  cuda-bindings==13.4.4 \
  filelock==4.2.12 \
  fsspec==2026.9.0 \
  idna==3.20 \
  jinja2==3.1.6 \
  msgpack==1.2.4 \
  networkx==3.7 \
  pillow==13.0.0 \
  pip_audit==2.10.1 \
  protobuf==6.33.5 \
  pygments==2.21.0 \
  requests==2.34.2 \
  setuptools==84.2.1 \
  sympy==1.14.0 \
  triton==3.9.0 \
  typing-extensions==4.16.0 \
  nvidia-cusparselt-cu13==0.8.1 \
  nvidia-nvshmem-cu13==3.7.2 \
  urllib3==2.8.0 \
  werkzeug==3.1.9
ARG TORCH_VERSION="torch==2.15.0"
ARG TORCH_URL="https://download.pytorch.org/whl/cu134"
RUN pip3 install --break-system-packages --no-deps ${TORCH_VERSION} \
  --index-url ${TORCH_URL}

# ───────────────────────────────────────────────────────────────────
# Additional nvidia libraries required
#
# Torch 2.15 wants NCCL >= 2.30.7. We pin the CUDA 13.4 build of NCCL
# so apt does not pick the 13.5 one.
#
# 11/20/26: NVSHMEM comes from the pip wheel (installed above) rather
# than apt, because the apt package (libnvshmem3-cuda-13) puts
# libnvshmem_host.so.3 in a directory the linker does not search.

RUN apt-get -y update && \
  apt-get remove -y --allow-change-held-packages libnccl-dev && \
  apt-get install -y --allow-change-held-packages \
  libnccl2=2.32.3-1+cuda13.4 && apt-get clean

# ───────────────────────────────────────────────────────────────────
# Register the pip-installed cuSPARSELt and NVSHMEM with the dynamic
# linker (instead of hard-coding site-packages paths in
# LD_LIBRARY_PATH). These are namespace packages, hence __path__.

RUN python3 -c "import nvidia.cusparselt, nvidia.nvshmem, os; \
  [print(os.path.join(list(m.__path__)[0], 'lib')) \
  for m in (nvidia.cusparselt, nvidia.nvshmem)]" \
  > /etc/ld.so.conf.d/nvidia-pip.conf && ldconfig

# ───────────────────────────────────────────────────────────────────
# Torch's cu13 wheels no longer bundle ptxas, so point Triton
# (used by torch.compile) at the one in the CUDA toolkit.

ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

# ───────────────────────────────────────────────────────────────────
# Copy the test script, set permissions and environment variables

WORKDIR /opt
COPY cuda_check.sh ./
RUN chmod 777 cuda_check.sh
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda/lib64:/usr/local/cuda-13.4/targets/x86_64-linux/lib

WORKDIR /root
